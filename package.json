{
  "name": "xiangdong-lab",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content:build": "node scripts/generate-content.mjs",
    "prestart": "npm run content:build",
    "start": "ng serve",
    "prebuild": "npm run content:build",
    "build": "ng build",
    "build:ssr": "npm run content:build && ng build --configuration production",
    "build:pages": "node scripts/build-pages.mjs",
    "watch": "npm run content:build && ng build --watch --configuration development",
    "test": "npm run content:build && ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr:xiangdong-lab": "node dist/xiangdong-lab/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
